# RentDrive Environment Variables

# Supabase Configurations
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Circle Developer Platform API
CIRCLE_API_KEY=TEST_API_KEY:your_circle_api_key_here
CIRCLE_KIT_KEY=KIT_KEY:your_circle_kit_key_here
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=TEST_CLIENT_KEY:your_circle_client_key_here
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
CIRCLE_ENTITY_SECRET=your_64_character_hex_entity_secret_here
CIRCLE_APP_ID=

# Wallet Private Key for Oracle/Admin updates & Deployment
PRIVATE_KEY=your_private_key_without_0x_prefix_here

# Arc Network Configuration
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000

# RainbowKit Wallet Connect Project ID
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Deployed Contract Address (once deployed)
NEXT_PUBLIC_RENTDRIVE_CONTRACT_ADDRESS=
